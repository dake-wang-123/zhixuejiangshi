<view class="page study-page">
  <view class="study-head">
    <view class="muted">智学伴练</view>
    <view class="title">{{displayTitle}}</view>
    <view class="muted" wx:if="{{course}}">课题原题已发给智学。请按它的问答作答，不要改写问题；进度条按内定环节顺序走，不能跳步。</view>
    <view class="muted" wx:else>还没选定课题。输入课题原题后发送，智学按内定问答上课。目录对不上的课题也可从学习页输入后跳到这里。</view>
    <step-bar
      wx:if="{{steps.length}}"
      steps="{{steps}}"
      current="{{currentIndex}}"
      completedCount="{{completedCount}}"
      finished="{{finished}}"
      bindchange="onStepBar"
    ></step-bar>
    <view class="review-banner" wx:if="{{reviewing}}" bindtap="onBackLive">
      正在回看「{{currentStep.title}}」。点这里回到当前环节继续学。
    </view>
    <view class="step-goal" wx:if="{{currentStep}}">
      <text class="muted">{{currentStep.group}}</text>
      <text class="goal">{{currentStep.title}}</text>
      <text class="muted" wx:if="{{currentStep.goal}}">{{currentStep.goal}}</text>
    </view>
  </view>
  <view class="error" wx:if="{{error}}">{{error}}</view>
  <scroll-view scroll-y class="thread" scroll-into-view="{{scrollInto}}" scroll-with-animation>
    <view class="empty cat-table-empty" wx:if="{{planning && !thread.length}}">正在把课题发给智学…</view>
    <view class="empty cat-table-empty" wx:elif="{{!thread.length && !sending}}">输入课题名称并发送，智学才会开始。不要改写题目。</view>
    <view
      id="m-{{item.id}}"
      class="bubble {{item.role === 'user' ? 'me' : 'bot'}}"
      wx:for="{{thread}}"
      wx:key="id"
    >{{item.content}}</view>
    <view class="follow-wrap" wx:if="{{followUps.length && !sending && !reviewing}}">
      <view class="muted">智学建议</view>
      <view
        class="follow"
        wx:for="{{followUps}}"
        wx:key="*this"
        data-text="{{item}}"
        bindtap="onFollow"
      >{{item}}</view>
    </view>
    <view class="muted thinking" wx:if="{{sending}}">
      <ui-icon name="spark" size="28" color="#8A8175"></ui-icon>
      <text>智学回复中…</text>
    </view>
  </scroll-view>
  <view class="composer" wx:if="{{!reviewing}}">
    <view class="draft-row">
      <textarea
        class="draft"
        placeholder="{{recording ? '正在听，松手后转成文字' : '输入课题原题，或按住麦克风说话'}}"
        value="{{draft}}"
        bindinput="onDraft"
        auto-height
        maxlength="2000"
        confirm-type="send"
        bindconfirm="onSend"
      ></textarea>
      <view
        class="mic {{recording ? 'on' : ''}}"
        catchtouchstart="onMicStart"
        catchtouchend="onMicEnd"
        catchtouchcancel="onMicEnd"
      >
        <ui-icon name="mic" size="36" color="{{recording ? '#FFFFFF' : '#5C7A5A'}}"></ui-icon>
      </view>
    </view>
    <view class="row composer-actions">
      <button class="btn btn-ghost mini" size="mini" bindtap="onClear">重新开始</button>
      <button class="btn btn-ghost mini" size="mini" bindtap="onRetry" wx:if="{{error}}" disabled="{{sending}}">再问一次</button>
      <button class="btn btn-ghost mini" size="mini" bindtap="onComplete" wx:if="{{steps.length && !finished}}" disabled="{{sending}}">完成本环节</button>
      <button class="btn mini" size="mini" bindtap="onSend" disabled="{{sending}}">发送</button>
    </view>
  </view>
</view>
