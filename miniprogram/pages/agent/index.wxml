<view class="page study-page">
  <view class="study-head">
    <view class="muted">智学伴练</view>
    <view class="title">{{displayTitle}}</view>
    <view class="muted" wx:if="{{lessonCode}}">课号 {{lessonCode}}</view>
    <view class="muted" wx:if="{{course}}">已把课程标题发给智学。下面是智能体自己的问答，小程序原样呈现。</view>
    <view class="muted" wx:else>未选课时智学先给引导语。可从课程目录点课，或在下方输入课题原题。</view>
    <view class="topic-box" wx:if="{{!course}}">
      <input
        class="field"
        placeholder="输入智学知识库中的课题原题"
        value="{{topicDraft}}"
        bindinput="onTopicDraft"
        confirm-type="done"
        bindconfirm="onStartTopic"
      />
      <button class="btn mini" size="mini" bindtap="onStartTopic">用这题开始</button>
    </view>
  </view>
  <view class="error" wx:if="{{error}}">{{error}}</view>
  <scroll-view scroll-y class="thread" scroll-into-view="{{scrollInto}}" scroll-with-animation>
    <view class="empty cat-table-empty" wx:if="{{planning && !thread.length}}">正在向智学取引导…</view>
    <view class="empty cat-table-empty" wx:elif="{{!thread.length && !sending}}">智学引导语马上出现。未选课时按它的问题作答，选了课会直接进入该课题流程。</view>
    <view
      id="m-{{item.id}}"
      class="bubble {{item.role === 'user' ? 'me' : 'bot'}}"
      wx:for="{{thread}}"
      wx:key="id"
      >{{item.content}}<text class="cursor" wx:if="{{item.streaming}}">▍</text></view>
    <view class="bubble bot thinking-bubble" wx:if="{{thinking}}">
      <view class="dots">
        <view class="dot"></view>
        <view class="dot"></view>
        <view class="dot"></view>
      </view>
      <view class="think-copy">
        <text>{{thinkHint || '智学正在想这一步…'}}</text>
        <text class="muted" wx:if="{{waitSec >= 3}}">已等待 {{waitSec}} 秒，教案长时会分段讲</text>
      </view>
    </view>
    <view class="follow-wrap" wx:if="{{followUps.length}}">
      <view class="muted">智学建议</view>
      <view
        class="follow"
        wx:for="{{followUps}}"
        wx:key="*this"
        data-text="{{item}}"
        bindtap="onFollow"
      >{{item}}</view>
    </view>
  </scroll-view>
  <view class="composer">
    <view class="draft-row">
      <textarea
        class="draft"
        placeholder="{{recording ? '正在听，再点麦克风结束并转成文字' : (course ? '回答智学的问题，或点右侧麦克风说话' : '回复智学引导，或输入课题原题')}}"
        value="{{draft}}"
        bindinput="onDraft"
        auto-height
        maxlength="2000"
        confirm-type="send"
        bindconfirm="onSend"
      ></textarea>
      <button
        class="mic {{recording ? 'on' : ''}}"
        hover-class="mic-hover"
        catchtap="onMicTap"
      >
        <ui-icon name="mic" size="36" color="{{recording ? '#FFFFFF' : '#5C7A5A'}}"></ui-icon>
      </button>
    </view>
    <view class="row composer-actions">
      <button class="btn btn-ghost mini" size="mini" bindtap="onClear">重新开始</button>
      <button class="btn btn-ghost mini" size="mini" bindtap="onRetry" wx:if="{{error}}" disabled="{{sending}}">再问一次</button>
      <button class="btn mini" size="mini" bindtap="onSend" disabled="{{sending}}">发送</button>
    </view>
  </view>
</view>
