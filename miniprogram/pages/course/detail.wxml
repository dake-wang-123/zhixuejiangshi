<view class="page study-page plain">
  <view class="empty" wx:if="{{loading}}">
    <view class="empty-icon">
      <ui-icon name="spark" size="48" color="#999999"></ui-icon>
    </view>
    {{hint || '正在进入智学伴练…'}}
  </view>

  <block wx:if="{{!loading && course}}">
    <view class="study-top">
      <view class="kicker">{{lessonCode ? ('课号 ' + lessonCode) : (course.category_id.name || '智学伴练')}}</view>
      <view class="title">{{displayTitle}}</view>
      <text class="guide">十步交付法带你吃透课程，一路通关至模拟讲课、诊断评价、说课训练，最终产出全套逐字稿及PPT框架</text>
      <view class="actions">
        <button class="text-btn" bindtap="onRetry" wx:if="{{error}}">再问一次</button>
      </view>
      <step-bar
        wx:if="{{currentPhase !== 'inspection' && steps.length}}"
        steps="{{steps}}"
        current="{{currentIndex}}"
        completedCount="{{completedCount}}"
        finished="{{finished}}"
        bind:change="onStepChange"
      ></step-bar>
      <view class="inspect-bar" wx:if="{{currentPhase === 'inspection'}}">
        <view class="inspect-node {{inspectionStep === 1 ? 'on' : ''}} {{exam1Done ? 'done' : ''}}">检验1 讲课</view>
        <view class="inspect-node {{inspectionStep === 2 ? 'on' : ''}} {{exam2Done ? 'done' : ''}}">检验2 说课</view>
      </view>
      <view class="review-bar" wx:if="{{viewingStep}}">
        <text class="review-copy">回看第{{viewingStep}}步 · {{viewingTitle}}</text>
        <text class="review-link" bindtap="onBackLive">回到最新</text>
        <text class="review-link" bindtap="onReplayStep">重新学习此步</text>
      </view>
      <view class="exam-gate" wx:if="{{inspectWait === 'exam1'}}">
        <view class="exam-title">恭喜你已完成十步交付法！</view>
        <view class="exam-sub">是否进入实战检验环节？点确认，或回复「好的 / 开始」。</view>
        <view class="exam-btn on" bindtap="onExam1">确认进入</view>
      </view>
      <view class="exam-gate" wx:elif="{{inspectWait === 'exam2'}}">
        <view class="exam-title">检验1已完成</view>
        <view class="exam-sub">是否进入检验2（说课训练）？点确认，或回复「好的 / 开始」。</view>
        <view class="exam-btn on" bindtap="onExam2">确认进入检验2</view>
      </view>
      <view class="exam-gate" wx:elif="{{allClear}}">
        <view class="exam-title">全部通关</view>
        <view class="exam-sub">讲课逐字稿、诊断报告、说课稿和 PPT 大纲都已写入学习成果。</view>
        <view class="exam-btn ghost" wx:if="{{exam2Ready}}" bindtap="onMakePpt">用说课稿生成 PPT</view>
      </view>
    </view>
    <view class="error" wx:if="{{error}}" style="padding: 12rpx 40rpx 0;">{{error}}</view>
    <scroll-view scroll-y class="thread" scroll-into-view="{{scrollInto}}" scroll-with-animation>
      <view class="thread-empty" wx:if="{{planning && !thread.length}}">{{hint || '正在恢复上次学习记录…'}}</view>
      <view class="thread-empty" wx:elif="{{!thread.length && !sending}}">还没有本课记录。发送后会按智学原文继续，下次进来还能接着学。</view>
      <block wx:for="{{thread}}" wx:key="id">
        <view id="{{item.anchor}}" wx:if="{{item.anchor}}"></view>
        <view id="m-{{item.id}}" class="msg msg-user" wx:if="{{item.role === 'user'}}">
          <view class="msg-user-bubble">{{item.preview || item.content}}</view>
        </view>
        <view id="m-{{item.id}}" class="msg msg-ai" wx:else>
          <view class="msg-ai-meta">智学<text wx:if="{{item.step && item.step <= 10}}"> · 第{{item.step}}步</text></view>
          <view class="ai-article" wx:if="{{item.blocks.length}}">
            <block wx:for="{{item.blocks}}" wx:for-item="block" wx:key="id">
              <view class="ai-block ai-{{block.kind}}">
                <view class="ai-kicker" wx:if="{{block.kicker}}">{{block.kicker}}</view>
                <rich-text nodes="{{block.nodes}}"></rich-text>
              </view>
            </block>
          </view>
          <view class="msg-ai-body" wx:else>{{item.content}}</view>
          <text class="cursor" wx:if="{{item.streaming}}">▍</text>
        </view>
      </block>
      <view class="thinking-row" wx:if="{{thinking}}">
        <view class="dots">
          <view class="dot"></view>
          <view class="dot dot-delay-2"></view>
          <view class="dot dot-delay-3"></view>
        </view>
        <view class="think-copy">
          <text>{{thinkHint || '智学正在想这一步…'}}</text>
          <text class="muted" wx:if="{{waitSec >= 3}}">已等待 {{waitSec}} 秒，教案长时会分段讲</text>
        </view>
      </view>
      <view class="follow-wrap" wx:if="{{followUps.length}}">
        <view class="muted">智学建议</view>
        <view
          class="follow"
          hover-class="follow-on"
          wx:for="{{followUps}}"
          wx:key="*this"
          data-text="{{item}}"
          bindtap="onFollow"
        >{{item}}</view>
      </view>
      <view id="thread-end"></view>
    </scroll-view>
    <view class="wx-composer">
      <view class="wx-bar">
        <view class="wx-plus" hover-class="wx-plus-on" bindtap="onPlus">+</view>
        <input
          class="wx-input"
          placeholder="回答智学的问题"
          value="{{draft}}"
          bindinput="onDraft"
          confirm-type="send"
          bindconfirm="onSend"
          maxlength="2000"
          cursor-spacing="24"
          adjust-position
        />
        <view class="wx-send {{draft && !sending ? 'ready' : ''}}" bindtap="onSend">发送</view>
      </view>
    </view>
  </block>
</view>
