<view class="page">
  <view class="hero">
    <view class="hero-row">
      <view class="hero-mark">
        <ui-icon name="user" size="40" color="#5C7A5A"></ui-icon>
      </view>
      <view class="grow">
        <text class="eyebrow">LECTURER</text>
        <text class="hero-title">我的</text>
      </view>
    </view>
    <text class="hero-sub">当前为管理员测试登录，可直接上传课程归档、走智学问答。</text>
  </view>
  <view class="error" wx:if="{{loginError}}">{{loginError}}</view>
  <view class="card" wx:if="{{account}}">
    <view class="title">{{account.username || '家庭教育讲师'}}{{isAdmin ? ' · 管理员' : ''}}</view>
    <view class="muted">账号 {{account.id}}</view>
    <view class="muted" wx:if="{{account.phoneNumber}}">手机 {{account.phoneNumber}}</view>
  </view>
  <view class="card" wx:else>
    <view class="title">尚未登录</view>
    <view class="desc">点下面直接进入已登记的管理员测试账号，无需微信 code。</view>
    <button class="btn" bindtap="onRelogin">管理员登录</button>
  </view>
  <view class="card">
    <view class="section-head" style="margin-top: 0;">
      <ui-icon name="file" size="32" color="#5C7A5A"></ui-icon>
      <text class="name">讲师资料</text>
    </view>
    <view class="label">从业年限</view>
    <input class="field" type="number" placeholder="例如 8" value="{{educationYears}}" bindinput="onYears" />
    <button class="btn" bindtap="onSaveProfile" disabled="{{saving}}">保存资料</button>
  </view>
  <view class="card">
    <view class="section-head" style="margin-top: 0;">
      <ui-icon name="tag" size="32" color="#5C7A5A"></ui-icon>
      <text class="name">会员</text>
    </view>
    <view class="desc" wx:if="{{membership}}">
      {{membership.level || '会员'}} · {{membership.status}} · 到期 {{membership.expire_time}}
    </view>
    <view class="muted" wx:else>当前没有会员记录。上架课程里标了会员免费的，需要有效会员才能按免费价学习。</view>
  </view>
  <view class="card">
    <view class="section-head" style="margin-top: 0;">
      <ui-icon name="slides" size="32" color="#5C7A5A"></ui-icon>
      <text class="name">我的课件</text>
    </view>
    <view class="muted" wx:if="{{!ppts.length}}">还没有生成过 PPT。可从教案或课程详情进入。</view>
    <view wx:for="{{ppts}}" wx:key="id" class="ppt-row">
      <view class="desc">{{item.title}} · {{item.status}}</view>
      <button class="btn mini" size="mini" wx:if="{{item.file_url}}" data-url="{{item.file_url}}" bindtap="onOpenPpt">下载</button>
    </view>
    <button class="btn btn-ghost" bindtap="onAllPpts">生成 / 查看全部课件</button>
  </view>
  <view class="card" wx:if="{{isAdmin}}">
    <view class="section-head" style="margin-top: 0;">
      <ui-icon name="folder" size="32" color="#5C7A5A"></ui-icon>
      <text class="name">管理员</text>
    </view>
    <view class="muted">智学知识库列不出 60 课时，在此上传分类文件或课题原件，标题归档到课程目录后供点课学习。</view>
    <button class="btn" bindtap="onAdminUpload">课程归档上传</button>
  </view>
  <view class="card" wx:else>
    <view class="section-head" style="margin-top: 0;">
      <ui-icon name="folder" size="32" color="#5C7A5A"></ui-icon>
      <text class="name">管理员入口</text>
    </view>
    <view class="muted">只有管理员能上传 60 课原件并归档目录。请输入已登记的管理员手机号开通。</view>
    <input class="field" type="number" placeholder="管理员手机号" value="{{adminCode}}" bindinput="onAdminCode" />
    <button class="btn btn-ghost" bindtap="onUnlockAdmin">开通管理员上传</button>
  </view>
  <view class="card">
    <view class="section-head" style="margin-top: 0;">
      <ui-icon name="chat" size="32" color="#5C7A5A"></ui-icon>
      <text class="name">意见反馈</text>
    </view>
    <textarea class="area" placeholder="功能问题、课题建议、解析不准，都可以写在这里。" value="{{feedback}}" bindinput="onFeedback" maxlength="1000" auto-height></textarea>
    <button class="btn btn-ghost" bindtap="onSendFeedback" disabled="{{sending}}">提交反馈</button>
  </view>
</view>
