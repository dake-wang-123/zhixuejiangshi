.study-page {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  padding-bottom: calc(280rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}
.study-head {
  background: #FFFBF5;
  border-radius: 28rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 12rpx 32rpx rgba(92, 122, 90, 0.1);
}
.study-head .title {
  margin: 6rpx 0 18rpx;
}
.review-banner {
  margin-top: 12rpx;
  padding: 12rpx 16rpx;
  border-radius: 16rpx;
  background: #F3EADF;
  color: #6F675C;
  font-size: 24rpx;
  line-height: 1.5;
}
  margin-top: 12rpx;
  padding-top: 12rpx;
  border-top: 1rpx solid #F0E6D6;
}
.goal {
  display: block;
  margin-top: 6rpx;
  font-size: 26rpx;
  color: #3F5A3E;
  line-height: 1.5;
}
.thread {
  flex: 1;
  height: 52vh;
}
.bubble {
  max-width: 86%;
  padding: 18rpx 22rpx;
  border-radius: 24rpx;
  margin-bottom: 16rpx;
  font-size: 28rpx;
  line-height: 1.55;
  white-space: pre-wrap;
}
.me {
  margin-left: auto;
  background: #5C7A5A;
  color: #fff;
  border-bottom-right-radius: 8rpx;
}
.bot {
  background: #FFFBF5;
  color: #2C2A26;
  border-bottom-left-radius: 8rpx;
}
.sys {
  max-width: 100%;
  margin: 0 0 16rpx;
  background: #F3EADF;
  color: #6F675C;
  font-size: 24rpx;
  border-radius: 16rpx;
}
.thinking {
  display: flex;
  align-items: center;
  padding-bottom: 12rpx;
}
.thinking text { margin-left: 8rpx; }
.composer {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: calc(24rpx + env(safe-area-inset-bottom));
  background: #FFFBF5;
  border-radius: 24rpx;
  padding: 16rpx 20rpx;
  box-shadow: 0 10rpx 30rpx rgba(44, 42, 38, 0.12);
}
.draft-row {
  display: flex;
  align-items: flex-end;
}
.draft {
  flex: 1;
  min-height: 72rpx;
  font-size: 28rpx;
  margin-right: 12rpx;
}
.mic {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #E8F0E4;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.mic.on {
  background: #D64545;
}
.follow-wrap {
  margin: 8rpx 0 20rpx;
}
.follow {
  display: inline-block;
  margin: 8rpx 12rpx 0 0;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: #E8F0E4;
  color: #3F5A3E;
  font-size: 24rpx;
}
.composer-actions {
  justify-content: flex-end;
  margin-top: 8rpx;
}
.mini { margin-right: 12rpx; }
