page {
  background: #F6F1E8;
  color: #2C2A26;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", sans-serif;
}

.page {
  min-height: 100vh;
  padding: 24rpx 28rpx calc(180rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.hero {
  padding: 8rpx 4rpx 28rpx;
}

.hero-row {
  display: flex;
  align-items: flex-start;
}

.hero-mark {
  width: 72rpx;
  height: 72rpx;
  border-radius: 24rpx;
  background: #E8F0E4;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 18rpx;
  flex-shrink: 0;
}

.eyebrow {
  font-size: 22rpx;
  letter-spacing: 4rpx;
  color: #8A8175;
}

.hero-title {
  display: block;
  margin-top: 6rpx;
  font-size: 42rpx;
  font-weight: 700;
  color: #2C2A26;
}

.hero-sub {
  display: block;
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #6F675C;
  line-height: 1.6;
}

.card {
  background: #FFFBF5;
  border-radius: 28rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 12rpx 32rpx rgba(92, 122, 90, 0.1);
}

.row {
  display: flex;
  align-items: center;
}

.muted {
  color: #8A8175;
  font-size: 24rpx;
}

.price {
  color: #C4754A;
  font-weight: 700;
}

.chip {
  display: inline-flex;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  background: #E8F0E4;
  color: #3F5A3E;
  font-size: 22rpx;
  margin-right: 12rpx;
  margin-top: 8rpx;
}

.chip-warn {
  background: #F6E4D4;
  color: #8A4B24;
}

.btn {
  margin-top: 20rpx;
  background: #5C7A5A;
  color: #fff;
  border-radius: 999rpx;
  font-size: 28rpx;
}

.btn::after {
  border: none;
}

.btn-ghost {
  background: #F3EADF;
  color: #3F5A3E;
}

.empty {
  text-align: center;
  padding: 72rpx 20rpx;
  color: #8A8175;
}

.empty-icon {
  width: 96rpx;
  height: 96rpx;
  border-radius: 32rpx;
  background: #EFE6D8;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 20rpx;
}

.cover {
  width: 160rpx;
  height: 160rpx;
  border-radius: 22rpx;
  background: #E8F0E4;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.cover-fallback {
  display: flex;
  align-items: center;
  justify-content: center;
}

.title {
  font-size: 32rpx;
  font-weight: 650;
  line-height: 1.4;
}

.desc {
  margin-top: 8rpx;
  font-size: 26rpx;
  color: #6F675C;
  line-height: 1.55;
}

.error {
  color: #B42318;
  font-size: 24rpx;
  padding: 12rpx 8rpx 20rpx;
}

.section-head {
  display: flex;
  align-items: center;
  margin: 8rpx 4rpx 16rpx;
}

.section-head .name {
  font-size: 30rpx;
  font-weight: 650;
  color: #3F5A3E;
  margin-left: 10rpx;
  flex: 1;
}

.section-head .count {
  font-size: 22rpx;
  color: #8A8175;
}

.progress-line {
  height: 10rpx;
  border-radius: 999rpx;
  background: #F4C7C7;
  overflow: hidden;
  margin-top: 14rpx;
}

.progress-line .fill {
  height: 100%;
  border-radius: 999rpx;
  background: #3F8F5A;
}

.toc-group {
  margin-top: 20rpx;
}

.toc-label {
  font-size: 22rpx;
  color: #8A8175;
  letter-spacing: 2rpx;
  margin-bottom: 8rpx;
}

.toc-item {
  display: flex;
  align-items: center;
  padding: 16rpx 12rpx;
  border-radius: 18rpx;
}

.toc-item.current {
  background: #E8F0E4;
}

.toc-index {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: #F3EADF;
  color: #6F675C;
  text-align: center;
  line-height: 44rpx;
  font-size: 20rpx;
  margin-right: 14rpx;
  flex-shrink: 0;
}

.toc-item.done .toc-index {
  background: #5C7A5A;
  color: #fff;
}

.toc-item.current .toc-index {
  background: #3F5A3E;
  color: #fff;
}

.step-body {
  min-height: 160rpx;
}

.label {
  margin: 18rpx 0 10rpx;
  font-size: 24rpx;
  color: #6F675C;
}

.field {
  background: #F6F1E8;
  border-radius: 16rpx;
  padding: 18rpx 20rpx;
  font-size: 28rpx;
}

.area {
  width: 100%;
  min-height: 220rpx;
  background: #F6F1E8;
  border-radius: 16rpx;
  padding: 18rpx 20rpx;
  font-size: 26rpx;
  box-sizing: border-box;
}
