<view class="page">
  <view class="hero">
    <view class="hero-row">
      <view class="hero-mark">
        <ui-icon name="leaf" size="40" color="#5C7A5A"></ui-icon>
      </view>
      <view class="grow">
        <text class="eyebrow">FAMILY EDUCATION</text>
        <text class="hero-title">家庭教育讲师自学</text>
      </view>
    </view>
    <text class="hero-sub">目录对应智学知识库 60 门原题。点已入库的课即把原题发给智学，按内定问答环节逐项作答；对不上的课题到学习页自行输入。</text>
    <text class="hero-meta" wx:if="{{!loading}}">智学目录 {{catalogCount}} 门 · 已入库 {{matchedCount}} 门 · {{categoryCount}} 个分类</text>
  </view>
  <view class="error" wx:if="{{error}}">{{error}}</view>
  <view class="empty" wx:if="{{loading}}">
    <view class="empty-icon">
      <ui-icon name="book-open" size="48" color="#8A8175"></ui-icon>
    </view>
    正在加载智学课程目录…
  </view>
  <scroll-view scroll-x class="cats" wx:if="{{categories.length}}">
    <view
      class="cat {{activeCategory === item.id ? 'on' : ''}}"
      wx:for="{{categories}}"
      wx:key="id"
      data-id="{{item.id}}"
      bindtap="onCategory"
    >{{item.name}}</view>
  </scroll-view>
  <view class="empty" wx:if="{{!loading && !categories.length}}">
    <view class="empty-icon">
      <ui-icon name="empty" size="48" color="#8A8175"></ui-icon>
    </view>
    还没有课程分类
  </view>
  <view class="cat-table" wx:for="{{sections}}" wx:key="id" wx:for-item="section">
    <view class="cat-table-head">
      <ui-icon name="folder" size="32" color="#5C7A5A"></ui-icon>
      <text class="name">{{section.name}}</text>
      <text class="count">{{section.courses.length}} 门</text>
    </view>
    <view class="cat-table-empty" wx:if="{{!section.courses.length}}">该分类暂无课程</view>
    <view
      class="cat-row"
      wx:for="{{section.courses}}"
      wx:for-item="item"
      wx:key="displayTitle"
      data-id="{{item.dbId}}"
      data-title="{{item.displayTitle}}"
      bindtap="onOpen"
    >
      <text class="cat-idx">{{index + 1}}</text>
      <view class="grow">
        <view class="title">{{item.displayTitle}}</view>
        <view class="desc">{{item.description}}</view>
        <view class="row chips">
          <text class="chip" wx:if="{{item.inLibrary}}">已入库</text>
          <text class="chip chip-warn" wx:else>未入库，点后自行输入</text>
          <text class="chip" wx:if="{{item.is_recommended}}">推荐</text>
        </view>
      </view>
    </view>
  </view>
</view>
