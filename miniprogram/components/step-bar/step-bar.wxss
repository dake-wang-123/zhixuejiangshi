.step-bar {
  padding: 4rpx 0 0;
}
.meta {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 14rpx;
}
.meta-strong {
  font-size: 26rpx;
  font-weight: 650;
  color: #333333;
}
.meta-muted {
  font-size: 22rpx;
  color: #999999;
}
.segments {
  display: flex;
}
.seg {
  flex: 1;
  height: 16rpx;
  border-radius: 999rpx;
  background: #D64545;
  margin-right: 8rpx;
}
.seg:last-child {
  margin-right: 0;
}
.seg.is-done {
  background: #3F8F5A;
}
.seg.is-current {
  box-shadow: 0 0 0 4rpx rgba(214, 69, 69, 0.22);
}
.seg.is-done.is-current {
  box-shadow: 0 0 0 4rpx rgba(63, 143, 90, 0.28);
}
.nodes {
  white-space: nowrap;
  margin-top: 18rpx;
}
.node {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  width: 88rpx;
  margin-right: 8rpx;
  color: #999999;
}
.dot {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  border: 2rpx solid #D64545;
  background: #FDECEC;
  color: #A33B3B;
  text-align: center;
  line-height: 40rpx;
  font-size: 18rpx;
  font-weight: 650;
}
.node.is-done .dot {
  border-color: #3F8F5A;
  background: #E4F3EA;
  color: #2F6B44;
}
.node.is-current .dot {
  box-shadow: 0 6rpx 16rpx rgba(214, 69, 69, 0.28);
}
.node.is-done.is-current .dot {
  box-shadow: 0 6rpx 16rpx rgba(63, 143, 90, 0.28);
}
.node.is-current {
  color: #333333;
}
.label {
  margin-top: 8rpx;
  font-size: 20rpx;
  max-width: 88rpx;
  overflow: hidden;
  text-overflow: ellipsis;
}
.legend {
  display: flex;
  margin-top: 12rpx;
  font-size: 20rpx;
  color: #999999;
}
.lg {
  display: flex;
  align-items: center;
  margin-right: 24rpx;
}
.lg-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  margin-right: 8rpx;
}
.lg-dot.red { background: #D64545; }
.lg-dot.green { background: #3F8F5A; }
