<view class="mine-page">
  <view class="profile">
    <view class="avatar-wrap">
      <image wx:if="{{profile.avatar}}" class="avatar" src="{{profile.avatar}}" mode="aspectFill"></image>
      <view wx:else class="avatar avatar-fallback">
        <ui-icon name="user" size="44" color="#4B6EF5"></ui-icon>
      </view>
    </view>
    <view class="grow">
      <text class="nickname">{{profile.name}}{{isAdmin ? ' · 管理员' : ''}}</text>
      <text class="login-tag">微信已登录</text>
    </view>
  </view>
  <view class="error pad" wx:if="{{loginError}}">{{loginError}}</view>
  <view class="pad" wx:if="{{!account}}">
    <view class="menu">
      <view class="muted" style="padding: 8rpx 8rpx 16rpx;">静默登录未完成。开发环境可用测试账号进入。</view>
      <button class="btn" bindtap="onRelogin">重新登录</button>
    </view>
  </view>

  <view class="vip {{vip.active ? 'on' : ''}}" bindtap="onVip">
    <view class="grow">
      <text class="vip-kicker">MEMBERSHIP</text>
      <text class="vip-title">会员中心</text>
      <text class="vip-sub">{{vip.label}} · {{vip.sub}}</text>
    </view>
    <text class="vip-go">查看权益</text>
  </view>

  <view class="menu">
    <view class="row" bindtap="onRecords">
      <view class="row-icon">
        <ui-icon name="book" size="36" color="#4B6EF5"></ui-icon>
      </view>
      <view class="grow">
        <text class="row-title">学习记录</text>
        <text class="row-sub" wx:if="{{recordPreview}}">{{recordPreview}}</text>
        <text class="row-sub" wx:else>还没有学过的课</text>
      </view>
      <text class="row-meta" wx:if="{{recordCount}}">{{recordCount}}</text>
      <ui-icon name="chevron" size="28" color="#C8C8C8"></ui-icon>
    </view>
    <view class="row" bindtap="onFavorites">
      <view class="row-icon">
        <ui-icon name="tag" size="36" color="#4B6EF5"></ui-icon>
      </view>
      <view class="grow">
        <text class="row-title">我的收藏</text>
        <text class="row-sub">标过星的课会留在这里</text>
      </view>
      <text class="row-meta" wx:if="{{favoriteCount}}">{{favoriteCount}}</text>
      <ui-icon name="chevron" size="28" color="#C8C8C8"></ui-icon>
    </view>
  </view>

  <view class="menu">
    <view class="row" bindtap="onHelp">
      <view class="row-icon">
        <ui-icon name="chat" size="36" color="#4B6EF5"></ui-icon>
      </view>
      <view class="grow">
        <text class="row-title">帮助中心</text>
      </view>
      <ui-icon name="chevron" size="28" color="#C8C8C8"></ui-icon>
    </view>
    <view class="row" bindtap="onAbout">
      <view class="row-icon">
        <ui-icon name="spark" size="36" color="#4B6EF5"></ui-icon>
      </view>
      <view class="grow">
        <text class="row-title">关于我们</text>
      </view>
      <ui-icon name="chevron" size="28" color="#C8C8C8"></ui-icon>
    </view>
    <view class="row" wx:if="{{isAdmin}}" bindtap="onAdminUpload">
      <view class="row-icon">
        <ui-icon name="folder" size="36" color="#4B6EF5"></ui-icon>
      </view>
      <view class="grow">
        <text class="row-title">课程归档上传</text>
      </view>
      <ui-icon name="chevron" size="28" color="#C8C8C8"></ui-icon>
    </view>
  </view>
</view>
