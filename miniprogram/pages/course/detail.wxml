<view class="page study-page">
  <view class="error" wx:if="{{error}}">{{error}}</view>

  <view class="empty" wx:if="{{loading}}">
    <view class="empty-icon">
      <ui-icon name="spark" size="48" color="#8A8175"></ui-icon>
    </view>
    {{hint || '正在进入智学…'}}
  </view>

  <block wx:if="{{!loading && course}}">
    <view class="study-head">
      <view class="muted" wx:if="{{course.category_id}}">{{course.category_id.name}} · 智学</view>
      <view class="muted" wx:else>智学</view>
      <view class="title">{{displayTitle}}</view>
      <step-bar
        wx:if="{{steps.length}}"
        steps="{{steps}}"
        current="{{currentIndex}}"
        completedCount="{{completedCount}}"
        finished="{{finished}}"
        bindchange="onStepBar"
      ></step-bar>
      <view class="muted" wx:else>智学列出环节后，这里会出现红绿进度条。对话、追问建议都按智能体原样展示。</view>
      <view class="step-goal" wx:if="{{currentStep}}">
        <text class="muted">当前环节（来自智学）</text>
        <text class="goal">{{currentStep.title}}</text>
      </view>
    </view>

    <scroll-view scroll-y class="thread" scroll-into-view="{{scrollInto}}" scroll-with-animation>
      <view class="empty cat-table-empty" wx:if="{{planning && !thread.length}}">正在调用智学智能体…</view>
      <view
        id="m-{{item.id}}"
        class="bubble {{item.role === 'user' ? 'me' : (item.role === 'system' ? 'sys' : 'bot')}}"
        wx:for="{{thread}}"
        wx:key="id"
      >{{item.content}}</view>
      <view class="follow-wrap" wx:if="{{followUps.length && !sending}}">
        <view class="muted">智学建议</view>
        <view
          class="follow"
          wx:for="{{followUps}}"
          wx:key="*this"
          data-text="{{item}}"
          bindtap="onFollow"
        >{{item}}</view>
      </view>
      <view class="muted thinking" wx:if="{{sending}}">
        <ui-icon name="spark" size="28" color="#8A8175"></ui-icon>
        <text>智学回复中…</text>
      </view>
    </scroll-view>

    <view class="composer">
      <view class="draft-row">
        <textarea
          class="draft"
          placeholder="{{recording ? '正在听，松手后转成文字' : '输入或按住右侧麦克风说话'}}"
          value="{{draft}}"
          bindinput="onDraft"
          auto-height
          maxlength="2000"
          confirm-type="send"
          bindconfirm="onSend"
        ></textarea>
        <view
          class="mic {{recording ? 'on' : ''}}"
          catchtouchstart="onMicStart"
          catchtouchend="onMicEnd"
          catchtouchcancel="onMicEnd"
        >
          <ui-icon name="mic" size="36" color="{{recording ? '#FFFFFF' : '#5C7A5A'}}"></ui-icon>
        </view>
      </view>
      <view class="row composer-actions">
        <button class="btn btn-ghost mini" size="mini" bindtap="onRetry" wx:if="{{error}}" disabled="{{sending}}">再问一次</button>
        <button class="btn btn-ghost mini" size="mini" bindtap="onComplete" wx:if="{{steps.length && !finished}}" disabled="{{sending}}">标记完成</button>
        <button class="btn mini" size="mini" bindtap="onSend" disabled="{{sending}}">发送</button>
      </view>
    </view>
  </block>
</view>
