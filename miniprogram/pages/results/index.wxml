<view class="page">
  <view class="hero">
    <view class="hero-row">
      <view class="hero-mark">
        <ui-icon name="book" size="40" color="#4B6EF5"></ui-icon>
      </view>
      <view class="grow">
        <text class="eyebrow">HISTORY</text>
        <text class="hero-title">学习记录</text>
      </view>
    </view>
    <text class="hero-sub">按最后学习时间排列。点一门课查看讲稿、诊断、说课和 PPT 大纲。</text>
  </view>
  <view class="error" wx:if="{{error}}">{{error}}</view>
  <view class="empty" wx:if="{{loading}}">正在读取学习记录…</view>
  <view class="empty" wx:elif="{{empty}}">
    <view class="empty-icon">
      <ui-icon name="book" size="48" color="#999999"></ui-icon>
    </view>
    还没有学习记录。去课程目录点一门课，或在顶部上传个人教案。
  </view>
  <view
    class="card lesson-card"
    hover-class="lesson-hover"
    hover-stay-time="80"
    wx:for="{{groups}}"
    wx:key="key"
    data-code="{{item.lessonCode}}"
    data-title="{{item.topicTitle}}"
    bindtap="onOpen"
  >
    <view class="row">
      <text class="lesson-code">{{item.lessonCode}}</text>
      <text
        class="star {{item.starred ? 'on' : ''}}"
        data-code="{{item.lessonCode}}"
        data-title="{{item.topicTitle}}"
        catchtap="onStar"
      >{{item.starred ? '已收藏' : '收藏'}}</text>
    </view>
    <view class="title">{{item.topicTitle}}</view>
    <view class="progress-line">
      <view class="fill" style="width: {{item.percent}}%;"></view>
    </view>
    <view class="muted" style="margin-top: 12rpx;">{{item.progressText}}</view>
    <view class="muted" wx:if="{{item.resultSummary}}">{{item.resultSummary}}</view>
  </view>
</view>
