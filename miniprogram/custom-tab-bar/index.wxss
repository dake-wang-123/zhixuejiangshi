.tabbar {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: calc(16rpx + env(safe-area-inset-bottom));
  height: 120rpx;
  background: #FFFBF5;
  border-radius: 40rpx;
  display: flex;
  box-shadow: 0 10rpx 30rpx rgba(44, 42, 38, 0.12);
  z-index: 100;
}

.item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #8A8175;
}

.item.active {
  color: #3F5A3E;
}

.icon {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: #F3EADF;
  text-align: center;
  line-height: 44rpx;
  font-size: 22rpx;
  margin-bottom: 6rpx;
}

.item.active .icon {
  background: #5C7A5A;
  color: #fff;
}

.text {
  font-size: 20rpx;
}
