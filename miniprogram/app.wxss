page {
  background: #F9F9F9;
  color: #333333;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", sans-serif;
  font-size: 32rpx;
  line-height: 1.7;
}

.page {
  min-height: 100vh;
  padding: 24rpx 40rpx calc(140rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.hero {
  padding: 8rpx 0 32rpx;
}

.hero-row {
  display: flex;
  align-items: flex-start;
}

.hero-mark {
  width: 72rpx;
  height: 72rpx;
  border-radius: 20rpx;
  background: #EEF1FE;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 18rpx;
  flex-shrink: 0;
}

.eyebrow {
  font-size: 24rpx;
  letter-spacing: 2rpx;
  color: #999999;
  line-height: 1.6;
}

.hero-title {
  display: block;
  margin-top: 4rpx;
  font-size: 40rpx;
  font-weight: 700;
  color: #333333;
  line-height: 1.6;
}

.hero-sub {
  display: block;
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #999999;
  line-height: 1.7;
}

.card {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  border: 1rpx solid #EEEEEE;
}

.row {
  display: flex;
  align-items: center;
}

.muted {
  color: #999999;
  font-size: 24rpx;
  line-height: 1.6;
}

.price {
  color: #C4754A;
  font-weight: 700;
}

.chip {
  display: inline-flex;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  background: #EEF1FE;
  color: #4B6EF5;
  font-size: 22rpx;
  margin-right: 12rpx;
  margin-top: 8rpx;
}

.chip-warn {
  background: #FFF1E8;
  color: #C27A4A;
}

.btn {
  margin-top: 20rpx;
  background: #4B6EF5;
  color: #fff;
  border-radius: 20rpx;
  font-size: 28rpx;
  line-height: 2;
}

.btn::after {
  border: none;
}

.btn-ghost {
  background: #F3F4F6;
  color: #333333;
}

.empty {
  text-align: center;
  padding: 72rpx 20rpx;
  color: #999999;
  font-size: 24rpx;
  line-height: 1.7;
}

.empty-icon {
  width: 96rpx;
  height: 96rpx;
  border-radius: 28rpx;
  background: #F3F4F6;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 20rpx;
}

.cover {
  width: 160rpx;
  height: 160rpx;
  border-radius: 20rpx;
  background: #EEF1FE;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.cover-fallback {
  display: flex;
  align-items: center;
  justify-content: center;
}

.title {
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1.6;
  color: #333333;
}

.desc {
  margin-top: 16rpx;
  font-size: 32rpx;
  color: #333333;
  line-height: 1.7;
}

.error {
  color: #C04545;
  font-size: 24rpx;
  line-height: 1.6;
  padding: 12rpx 0 20rpx;
}

.section-head {
  display: flex;
  align-items: center;
  margin: 8rpx 0 16rpx;
}

.section-head .name {
  font-size: 36rpx;
  font-weight: 700;
  color: #333333;
  margin-left: 10rpx;
  flex: 1;
  line-height: 1.6;
}

.section-head .count {
  font-size: 24rpx;
  color: #999999;
}

.progress-line {
  height: 8rpx;
  border-radius: 999rpx;
  background: #EEEEEE;
  overflow: hidden;
  margin-top: 14rpx;
}

.progress-line .fill {
  height: 100%;
  border-radius: 999rpx;
  background: #4B6EF5;
}

.label {
  margin: 18rpx 0 10rpx;
  font-size: 24rpx;
  color: #999999;
  line-height: 1.6;
}

.field {
  background: #FFFFFF;
  border: 1rpx solid #E5E5E5;
  border-radius: 24rpx;
  padding: 20rpx 24rpx;
  font-size: 32rpx;
  line-height: 1.6;
  color: #333333;
}

.area {
  width: 100%;
  min-height: 220rpx;
  background: #FFFFFF;
  border: 1rpx solid #E5E5E5;
  border-radius: 24rpx;
  padding: 20rpx 24rpx;
  font-size: 32rpx;
  line-height: 1.7;
  box-sizing: border-box;
  color: #333333;
}
