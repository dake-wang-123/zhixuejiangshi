<view class="page study-page">
  <view class="error" wx:if="{{error}}">{{error}}</view>

  <view class="empty" wx:if="{{loading}}">
    <view class="empty-icon">
      <ui-icon name="spark" size="48" color="#8A8175"></ui-icon>
    </view>
    {{hint || '正在进入智学…'}}
  </view>

  <block wx:if="{{!loading && course}}">
    <view class="study-head">
      <view class="muted" wx:if="{{course.category_id}}">{{course.category_id.name}} · 智学引导</view>
      <view class="muted" wx:else>智学引导</view>
      <view class="title">{{displayTitle}}</view>
      <step-bar
        wx:if="{{steps.length}}"
        steps="{{steps}}"
        current="{{currentIndex}}"
        completedCount="{{completedCount}}"
        finished="{{finished}}"
        bindchange="onStepBar"
      ></step-bar>
      <view class="step-goal" wx:if="{{currentStep}}">
        <text class="muted">本节目标</text>
        <text class="goal">{{currentStep.goal || currentStep.title}}</text>
      </view>
    </view>

    <scroll-view scroll-y class="thread" scroll-into-view="{{scrollInto}}" scroll-with-animation>
      <view class="empty cat-table-empty" wx:if="{{planning}}">智学正在排出学习环节，请稍候…</view>
      <view
        id="m-{{item.id}}"
        class="bubble {{item.role === 'user' ? 'me' : (item.role === 'system' ? 'sys' : 'bot')}}"
        wx:for="{{thread}}"
        wx:key="id"
      >{{item.content}}</view>
      <view class="muted thinking" wx:if="{{sending}}">
        <ui-icon name="spark" size="28" color="#8A8175"></ui-icon>
        <text>智学按本节引导中…</text>
      </view>
    </scroll-view>

    <view class="composer" wx:if="{{!finished}}">
      <view class="row composer-actions" wx:if="{{currentIndex !== completedCount}}">
        <button class="btn mini" size="mini" bindtap="onBackCurrent">回到当前红格</button>
      </view>
      <block wx:else>
        <textarea
          class="draft"
          placeholder="就本节向智学提问，不要跳到后面的环节"
          value="{{draft}}"
          bindinput="onDraft"
          auto-height
          maxlength="2000"
          confirm-type="send"
          bindconfirm="onSend"
        ></textarea>
        <view class="row composer-actions">
          <button class="btn btn-ghost mini" size="mini" bindtap="onRetry" wx:if="{{error}}" disabled="{{sending}}">继续本节</button>
          <button class="btn btn-ghost mini" size="mini" bindtap="onComplete" disabled="{{sending}}">完成本节</button>
          <button class="btn mini" size="mini" bindtap="onSend" disabled="{{sending}}">发送</button>
        </view>
      </block>
    </view>
    <view class="composer" wx:else>
      <view class="muted">进度条已全部变绿。可点绿色环节回看，或生成课件。</view>
      <button class="btn" bindtap="onPpt">生成本课课件</button>
    </view>
  </block>
</view>
