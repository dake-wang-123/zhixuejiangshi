.grow { flex: 1; min-width: 0; }
.cats {
  white-space: nowrap;
  margin-bottom: 20rpx;
}
.cat {
  display: inline-block;
  padding: 12rpx 26rpx;
  margin-right: 12rpx;
  border-radius: 999rpx;
  background: #F3EADF;
  color: #6F675C;
  font-size: 24rpx;
}
.cat.on {
  background: #5C7A5A;
  color: #fff;
}
.course-card {
  align-items: flex-start;
}
.chips {
  flex-wrap: wrap;
  margin-top: 8rpx;
}
.hero-meta {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #8A8175;
}
.cat-table {
  background: #FFFBF5;
  border-radius: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 12rpx 32rpx rgba(92, 122, 90, 0.1);
  overflow: hidden;
}
.cat-table-head {
  display: flex;
  align-items: center;
  padding: 22rpx 24rpx;
  background: #E8F0E4;
}
.cat-table-head .name {
  font-size: 30rpx;
  font-weight: 650;
  color: #3F5A3E;
  margin-left: 10rpx;
  flex: 1;
}
.cat-table-head .count {
  font-size: 22rpx;
  color: #5C7A5A;
}
.cat-table-empty {
  text-align: center;
  padding: 36rpx 20rpx;
  color: #8A8175;
  font-size: 24rpx;
}
.cat-row {
  display: flex;
  align-items: flex-start;
  padding: 22rpx 24rpx;
  border-top: 1rpx solid #F0E6D6;
}
.cat-idx {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: #F3EADF;
  color: #6F675C;
  text-align: center;
  line-height: 44rpx;
  font-size: 22rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}
