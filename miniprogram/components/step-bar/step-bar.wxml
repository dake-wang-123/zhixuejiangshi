<view class="step-bar">
  <view class="meta">
    <text class="meta-strong">{{currentLabel}}</text>
    <text class="meta-muted">{{completedCount}}/10 已打卡</text>
  </view>
  <scroll-view scroll-x class="nodes" enable-flex scroll-into-view="node-{{current}}" scroll-with-animation>
    <view
      id="node-{{index}}"
      class="node is-{{item.status}}"
      hover-class="node-on"
      wx:for="{{steps}}"
      wx:key="key"
      data-index="{{index}}"
      bindtap="onTap"
    >
      <view class="dot">{{item.done ? '✓' : item.mark}}</view>
      <text class="label">{{item.shortTitle}}</text>
    </view>
  </scroll-view>
</view>
