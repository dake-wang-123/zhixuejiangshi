.step-bar {
  padding: 4rpx 0 0;
}

.meta {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 14rpx;
}

.meta-strong {
  font-size: 26rpx;
  font-weight: 700;
  color: #333333;
}

.meta-muted {
  font-size: 22rpx;
  color: #999999;
}

.nodes {
  white-space: nowrap;
  width: 100%;
}

.node {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  width: 92rpx;
  margin-right: 8rpx;
  color: #B8B8B8;
}

.node-on {
  opacity: 0.8;
}

.dot {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  border: 2rpx solid #D8D8D8;
  background: #F3F3F3;
  color: #999999;
  text-align: center;
  line-height: 44rpx;
  font-size: 20rpx;
  font-weight: 700;
}

.node.is-done {
  color: #3F8F5A;
}

.node.is-done .dot {
  border-color: #3F8F5A;
  background: #E4F3EA;
  color: #2F6B44;
}

.node.is-current {
  color: #4B6EF5;
}

.node.is-current .dot {
  border-color: #4B6EF5;
  background: #4B6EF5;
  color: #FFFFFF;
}

.node.is-todo .dot {
  border-color: #E0E0E0;
  background: #F5F5F5;
  color: #B8B8B8;
}

.label {
  margin-top: 8rpx;
  font-size: 20rpx;
  max-width: 92rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  line-height: 1.4;
}
