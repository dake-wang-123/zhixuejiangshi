.grow { flex: 1; min-width: 0; }

.catalog-page {
  padding-top: 8rpx;
}

.hero.tight {
  padding: 4rpx 0 16rpx;
}

.hero.tight .hero-sub {
  margin-top: 10rpx;
}

.hero.tight .hero-meta {
  margin-top: 8rpx;
}

.plan-strip {
  display: flex;
  align-items: center;
  margin: 0 0 16rpx;
  padding: 16rpx 8rpx;
}

.plan-strip-text {
  font-size: 26rpx;
  color: #666666;
  line-height: 1.6;
}

.plan-strip-hint {
  flex: 1;
  margin-left: 16rpx;
  font-size: 22rpx;
  color: #BBBBBB;
  line-height: 1.6;
}

.plan-panel {
  margin: 0 0 20rpx;
  padding: 20rpx 22rpx 16rpx;
  border-radius: 16rpx;
  background: #F7F8FC;
  border: 1rpx solid #EEEEEE;
  box-sizing: border-box;
}

.plan-panel-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333333;
  line-height: 1.6;
}

.plan-panel-sub {
  display: block;
  margin: 6rpx 0 8rpx;
  font-size: 24rpx;
  color: #999999;
  line-height: 1.6;
}

.plan-area {
  min-height: 180rpx;
  background: #FFFFFF;
}

.upload-cancel {
  margin-top: 12rpx;
  text-align: center;
  font-size: 24rpx;
  color: #999999;
  line-height: 1.6;
}

.hero-meta {
  display: block;
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #999999;
  line-height: 1.6;
}

.cats {
  white-space: nowrap;
  margin: 0 0 16rpx;
}

.cat {
  display: inline-block;
  padding: 12rpx 24rpx;
  margin-right: 12rpx;
  border-radius: 999rpx;
  background: #FFFFFF;
  color: #999999;
  font-size: 24rpx;
  line-height: 1.6;
  border: 1rpx solid #E5E5E5;
}

.cat.on {
  background: #4B6EF5;
  color: #FFFFFF;
  border-color: #4B6EF5;
}

.group {
  background: #FFFFFF;
  border-radius: 20rpx;
  margin-bottom: 32rpx;
  overflow: hidden;
  border: 1rpx solid #EEEEEE;
}

.group-head {
  display: flex;
  align-items: center;
  padding: 28rpx 32rpx;
  background: #F7F8FC;
  border-left: 8rpx solid #4B6EF5;
}

.group-head .name {
  font-size: 36rpx;
  font-weight: 700;
  color: #333333;
  line-height: 1.6;
}

.group-head .count {
  font-size: 24rpx;
  color: #999999;
  line-height: 1.6;
}

.group-empty {
  text-align: center;
  padding: 36rpx 20rpx;
  color: #999999;
  font-size: 24rpx;
  line-height: 1.7;
}

.lesson {
  padding: 32rpx;
  border-top: 1rpx solid #F0F0F0;
}

.lesson-hover {
  background: #F5F7FF;
}

.lesson-code {
  display: block;
  font-size: 24rpx;
  color: #999999;
  letter-spacing: 1rpx;
  line-height: 1.6;
}

.lesson-title {
  margin-top: 8rpx;
  font-size: 32rpx;
  font-weight: 700;
  color: #333333;
  line-height: 1.6;
}
