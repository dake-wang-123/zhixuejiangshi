.file-row {
  display: flex;
  align-items: flex-start;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #EEEEEE;
}
.file-row .chip {
  flex-shrink: 0;
  margin-top: 8rpx;
}
.cats {
  white-space: nowrap;
  margin: 12rpx 0 8rpx;
}
.cat {
  display: inline-block;
  padding: 10rpx 22rpx;
  margin-right: 10rpx;
  border-radius: 999rpx;
  background: #FFFFFF;
  color: #999999;
  font-size: 24rpx;
  border: 1rpx solid #E5E5E5;
}
.cat.on {
  background: #4B6EF5;
  color: #fff;
  border-color: #4B6EF5;
}
