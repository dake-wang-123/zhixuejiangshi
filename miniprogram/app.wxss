page {
  background: #F6F1E8;
  color: #2C2A26;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", sans-serif;
}

.page {
  min-height: 100vh;
  padding: 24rpx 28rpx calc(160rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.hero {
  padding: 12rpx 8rpx 28rpx;
}

.eyebrow {
  font-size: 24rpx;
  letter-spacing: 4rpx;
  color: #8A8175;
}

.hero-title {
  display: block;
  margin-top: 8rpx;
  font-size: 44rpx;
  font-weight: 700;
  color: #2C2A26;
}

.hero-sub {
  display: block;
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #6F675C;
  line-height: 1.6;
}

.card {
  background: #FFFBF5;
  border-radius: 28rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 12rpx 32rpx rgba(92, 122, 90, 0.12);
}

.row {
  display: flex;
  align-items: center;
}

.muted {
  color: #8A8175;
  font-size: 24rpx;
}

.price {
  color: #C4754A;
  font-weight: 700;
}

.chip {
  display: inline-flex;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  background: #E8F0E4;
  color: #3F5A3E;
  font-size: 22rpx;
  margin-right: 12rpx;
}

.chip-warn {
  background: #F6E4D4;
  color: #8A4B24;
}

.btn {
  margin-top: 20rpx;
  background: #5C7A5A;
  color: #fff;
  border-radius: 999rpx;
  font-size: 28rpx;
}

.btn::after {
  border: none;
}

.btn-ghost {
  background: #F3EADF;
  color: #3F5A3E;
}

.empty {
  text-align: center;
  padding: 80rpx 20rpx;
  color: #8A8175;
}

.cover {
  width: 160rpx;
  height: 160rpx;
  border-radius: 20rpx;
  background: #E8F0E4;
  margin-right: 24rpx;
}

.title {
  font-size: 32rpx;
  font-weight: 650;
  line-height: 1.4;
}

.desc {
  margin-top: 8rpx;
  font-size: 26rpx;
  color: #6F675C;
  line-height: 1.55;
}

.error {
  color: #B42318;
  font-size: 24rpx;
  padding: 12rpx 8rpx 20rpx;
}
