.grow { flex: 1; min-width: 0; }

.upload-card {
  background: #F7F8FC;
  border-radius: 20rpx;
  padding: 32rpx;
  margin-bottom: 28rpx;
  border: 1rpx solid #E4E8F6;
  box-sizing: border-box;
}

.upload-head {
  display: flex;
  align-items: flex-start;
}

.upload-title {
  display: block;
  margin-top: 4rpx;
  font-size: 36rpx;
  font-weight: 700;
  color: #333333;
  line-height: 1.6;
}

.upload-sub {
  display: block;
  margin-top: 16rpx;
  font-size: 26rpx;
  color: #666666;
  line-height: 1.7;
}

.plan-area {
  min-height: 220rpx;
  background: #FFFFFF;
}

.upload-cancel {
  margin-top: 16rpx;
  text-align: center;
  font-size: 24rpx;
  color: #999999;
  line-height: 1.6;
}

.hero-meta {
  display: block;
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #999999;
  line-height: 1.6;
}

.cats {
  white-space: nowrap;
  margin: 0 0 28rpx;
}

.cat {
  display: inline-block;
  padding: 12rpx 24rpx;
  margin-right: 12rpx;
  border-radius: 999rpx;
  background: #FFFFFF;
  color: #999999;
  font-size: 24rpx;
  line-height: 1.6;
  border: 1rpx solid #E5E5E5;
}

.cat.on {
  background: #4B6EF5;
  color: #FFFFFF;
  border-color: #4B6EF5;
}

.group {
  background: #FFFFFF;
  border-radius: 20rpx;
  margin-bottom: 32rpx;
  overflow: hidden;
  border: 1rpx solid #EEEEEE;
}

.group-head {
  display: flex;
  align-items: center;
  padding: 28rpx 32rpx;
  background: #F7F8FC;
  border-left: 8rpx solid #4B6EF5;
}

.group-head .name {
  font-size: 36rpx;
  font-weight: 700;
  color: #333333;
  line-height: 1.6;
}

.group-head .count {
  font-size: 24rpx;
  color: #999999;
  line-height: 1.6;
}

.group-empty {
  text-align: center;
  padding: 36rpx 20rpx;
  color: #999999;
  font-size: 24rpx;
  line-height: 1.7;
}

.lesson {
  padding: 32rpx;
  border-top: 1rpx solid #F0F0F0;
}

.lesson-hover {
  background: #F5F7FF;
}

.lesson-code {
  display: block;
  font-size: 24rpx;
  color: #999999;
  letter-spacing: 1rpx;
  line-height: 1.6;
}

.lesson-title {
  margin-top: 8rpx;
  font-size: 32rpx;
  font-weight: 700;
  color: #333333;
  line-height: 1.6;
}
