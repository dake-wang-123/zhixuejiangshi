page {
  background: #F9F9F9;
  color: #333333;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", sans-serif;
  font-size: 32rpx;
  line-height: 1.7;
}

.page {
  min-height: 100vh;
  padding: 24rpx 40rpx calc(140rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.hero {
  padding: 8rpx 0 32rpx;
}

.hero-row {
  display: flex;
  align-items: flex-start;
}

.hero-mark {
  width: 72rpx;
  height: 72rpx;
  border-radius: 20rpx;
  background: #EEF1FE;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 18rpx;
  flex-shrink: 0;
}

.eyebrow {
  font-size: 24rpx;
  letter-spacing: 2rpx;
  color: #999999;
  line-height: 1.6;
}

.hero-title {
  display: block;
  margin-top: 4rpx;
  font-size: 40rpx;
  font-weight: 700;
  color: #333333;
  line-height: 1.6;
}

.hero-sub {
  display: block;
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #999999;
  line-height: 1.7;
}

.card {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  border: 1rpx solid #EEEEEE;
}

.row {
  display: flex;
  align-items: center;
}

.muted {
  color: #999999;
  font-size: 24rpx;
  line-height: 1.6;
}

.price {
  color: #C4754A;
  font-weight: 700;
}

.chip {
  display: inline-flex;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  background: #EEF1FE;
  color: #4B6EF5;
  font-size: 22rpx;
  margin-right: 12rpx;
  margin-top: 8rpx;
}

.chip-warn {
  background: #FFF1E8;
  color: #C27A4A;
}

.btn {
  margin-top: 20rpx;
  background: #4B6EF5;
  color: #fff;
  border-radius: 20rpx;
  font-size: 28rpx;
  line-height: 2;
}

.btn::after {
  border: none;
}

.btn-ghost {
  background: #F3F4F6;
  color: #333333;
}

.empty {
  text-align: center;
  padding: 72rpx 20rpx;
  color: #999999;
  font-size: 24rpx;
  line-height: 1.7;
}

.empty-icon {
  width: 96rpx;
  height: 96rpx;
  border-radius: 28rpx;
  background: #F3F4F6;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 20rpx;
}

.cover {
  width: 160rpx;
  height: 160rpx;
  border-radius: 20rpx;
  background: #EEF1FE;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.cover-fallback {
  display: flex;
  align-items: center;
  justify-content: center;
}

.title {
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1.6;
  color: #333333;
}

.desc {
  margin-top: 16rpx;
  font-size: 32rpx;
  color: #333333;
  line-height: 1.7;
}

.error {
  color: #C04545;
  font-size: 24rpx;
  line-height: 1.6;
  padding: 12rpx 0 20rpx;
}

.section-head {
  display: flex;
  align-items: center;
  margin: 8rpx 0 16rpx;
}

.section-head .name {
  font-size: 36rpx;
  font-weight: 700;
  color: #333333;
  margin-left: 10rpx;
  flex: 1;
  line-height: 1.6;
}

.section-head .count {
  font-size: 24rpx;
  color: #999999;
}

.progress-line {
  height: 8rpx;
  border-radius: 999rpx;
  background: #EEEEEE;
  overflow: hidden;
  margin-top: 14rpx;
}

.progress-line .fill {
  height: 100%;
  border-radius: 999rpx;
  background: #4B6EF5;
}

.label {
  margin: 18rpx 0 10rpx;
  font-size: 24rpx;
  color: #999999;
  line-height: 1.6;
}

.field {
  background: #FFFFFF;
  border: 1rpx solid #E5E5E5;
  border-radius: 24rpx;
  padding: 20rpx 24rpx;
  font-size: 32rpx;
  line-height: 1.6;
  color: #333333;
}

.area {
  width: 100%;
  min-height: 220rpx;
  background: #FFFFFF;
  border: 1rpx solid #E5E5E5;
  border-radius: 24rpx;
  padding: 20rpx 24rpx;
  font-size: 32rpx;
  line-height: 1.7;
  box-sizing: border-box;
  color: #333333;
}

.study-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  padding: 0;
  background: #F9F9F9;
  box-sizing: border-box;
}

.study-page.tabbed {
  padding-bottom: 370rpx;
}

.study-page.plain {
  padding-bottom: 280rpx;
}

.study-top {
  padding: 20rpx 40rpx 16rpx;
  background: #FFFFFF;
  border-bottom: 1rpx solid #EEEEEE;
}

.study-top .kicker {
  font-size: 24rpx;
  color: #999999;
  line-height: 1.6;
}

.study-top .title {
  margin-top: 4rpx;
  font-size: 40rpx;
  font-weight: 700;
  color: #333333;
  line-height: 1.6;
}

.study-top .sub {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #999999;
  line-height: 1.7;
}

.study-top .actions {
  margin-top: 12rpx;
  display: flex;
  align-items: center;
}

.study-top .text-btn {
  margin: 0 24rpx 0 0;
  padding: 0;
  background: transparent;
  color: #4B6EF5;
  font-size: 24rpx;
  line-height: 1.6;
}

.study-top .text-btn::after {
  border: none;
}

.topic-box {
  margin-top: 16rpx;
}

.topic-box .field {
  margin-bottom: 12rpx;
}

.thread {
  flex: 1;
  height: 1px;
  padding: 24rpx 40rpx 8rpx;
  box-sizing: border-box;
}

.thread-empty {
  padding: 80rpx 12rpx;
  text-align: center;
  color: #999999;
  font-size: 24rpx;
  line-height: 1.7;
}

.msg {
  margin-bottom: 32rpx;
}

.msg-ai {
  width: 100%;
}

.msg-ai-meta {
  font-size: 24rpx;
  color: #999999;
  margin-bottom: 10rpx;
  line-height: 1.6;
}

.msg-ai-body {
  font-size: 32rpx;
  line-height: 1.7;
  color: #333333;
}

.msg-user {
  display: flex;
  justify-content: flex-end;
}

.msg-user-bubble {
  max-width: 78%;
  padding: 16rpx 24rpx;
  border-radius: 20rpx 20rpx 6rpx 20rpx;
  background: #4B6EF5;
  color: #FFFFFF;
  font-size: 32rpx;
  line-height: 1.6;
  white-space: pre-wrap;
  word-break: break-all;
}

.thinking-row {
  display: flex;
  align-items: flex-start;
  padding: 8rpx 0 24rpx;
}

.think-copy {
  display: flex;
  flex-direction: column;
  margin-left: 12rpx;
}

.think-copy .muted {
  margin-top: 6rpx;
}

.dots {
  display: flex;
  align-items: center;
  height: 40rpx;
  padding-top: 6rpx;
}

.dot {
  width: 10rpx;
  height: 10rpx;
  margin-right: 8rpx;
  border-radius: 50%;
  background: #4B6EF5;
  animation: bounce 1s infinite ease-in-out;
}

.dot-delay-2 {
  animation-delay: 0.15s;
}

.dot-delay-3 {
  animation-delay: 0.3s;
}

.cursor {
  color: #4B6EF5;
  font-weight: 700;
  animation: blink 0.9s step-end infinite;
}

@keyframes bounce {
  0% {
    opacity: 0.25;
    transform: translateY(0);
  }
  40% {
    opacity: 1;
    transform: translateY(-3px);
  }
  80% {
    opacity: 0.25;
    transform: translateY(0);
  }
  100% {
    opacity: 0.25;
    transform: translateY(0);
  }
}

@keyframes blink {
  0% { opacity: 1; }
  50% { opacity: 0; }
  100% { opacity: 1; }
}

.follow-wrap {
  margin: 0 0 24rpx;
}

.follow-wrap .muted {
  margin-bottom: 8rpx;
}

.follow {
  display: inline-block;
  margin: 8rpx 12rpx 0 0;
  padding: 12rpx 20rpx;
  border-radius: 999rpx;
  background: #FFFFFF;
  color: #333333;
  font-size: 24rpx;
  line-height: 1.6;
  border: 1rpx solid #E5E5E5;
}

.follow-on {
  background: #F3F5FF;
  border-color: #4B6EF5;
  color: #4B6EF5;
}

.wx-composer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 80;
  background: #F7F7F7;
  border-top: 1rpx solid #EDEDED;
  padding: 12rpx 16rpx 20rpx;
  box-sizing: border-box;
}

.study-page.tabbed .wx-composer {
  bottom: 148rpx;
  padding-bottom: 12rpx;
}

.wx-bar {
  display: flex;
  align-items: center;
}

.wx-plus {
  width: 64rpx;
  height: 64rpx;
  line-height: 58rpx;
  text-align: center;
  font-size: 44rpx;
  color: #333333;
  background: #FFFFFF;
  border: 1rpx solid #E5E5E5;
  border-radius: 50%;
  flex-shrink: 0;
}

.wx-plus-on {
  background: #F0F0F0;
}

.wx-input {
  flex: 1;
  height: 72rpx;
  min-height: 72rpx;
  margin: 0 16rpx;
  padding: 0 20rpx;
  box-sizing: border-box;
  background: #FFFFFF;
  border-radius: 8rpx;
  font-size: 32rpx;
  line-height: 72rpx;
  color: #333333;
}

.wx-send {
  flex-shrink: 0;
  min-width: 88rpx;
  text-align: center;
  font-size: 32rpx;
  line-height: 72rpx;
  color: #B8B8B8;
}

.wx-send.ready {
  color: #07C160;
}
