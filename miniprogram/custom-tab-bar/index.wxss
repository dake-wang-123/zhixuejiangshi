.tabbar {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: calc(16rpx + env(safe-area-inset-bottom));
  height: 120rpx;
  background: #FFFBF5;
  border-radius: 40rpx;
  display: flex;
  box-shadow: 0 10rpx 30rpx rgba(44, 42, 38, 0.1);
  z-index: 100;
  border: 1rpx solid rgba(92, 122, 90, 0.08);
}

.item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #8A8175;
}

.item.active {
  color: #3F5A3E;
}

.icon-wrap {
  width: 56rpx;
  height: 56rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 4rpx;
}

.item.active .icon-wrap {
  background: #E8F0E4;
}

.icon {
  width: 40rpx;
  height: 40rpx;
}

.text {
  font-size: 20rpx;
  letter-spacing: 1rpx;
}
