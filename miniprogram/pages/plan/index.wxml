<view class="page">
  <view class="hero">
    <view class="hero-row">
      <view class="hero-mark">
        <ui-icon name="file" size="40" color="#5C7A5A"></ui-icon>
      </view>
      <view class="grow">
        <text class="eyebrow">LESSON PLAN</text>
        <text class="hero-title">上传教案</text>
      </view>
    </view>
    <text class="hero-sub">智能体会拆出课程名称和步骤。解析完成后，名称会写进课程目录，并按分类排列。</text>
  </view>
  <view class="error" wx:if="{{error}}">{{error}}</view>
  <view class="card">
    <view class="label">教案标题</view>
    <input class="field" placeholder="例如：亲子沟通工作坊第 3 讲" value="{{title}}" bindinput="onTitle" />
    <view class="label">教案文件</view>
    <button class="btn btn-ghost" bindtap="onChoose">从聊天记录选择文件</button>
    <view class="muted" wx:if="{{fileName}}">已选 {{fileName}}</view>
    <view class="label">教案全文（用于智能体解析）</view>
    <textarea class="area" placeholder="粘贴 TXT / Markdown 全文。PDF、PPT 请先转成文字再贴到这里。" value="{{text}}" bindinput="onText" maxlength="20000" auto-height></textarea>
    <view class="muted" wx:if="{{progress}}">{{progress}}</view>
    <button class="btn" bindtap="onSubmit" disabled="{{submitting}}">{{submitting ? '提交中…' : '上传并解析'}}</button>
    <button class="btn btn-ghost" bindtap="onMakePpt" disabled="{{submitting}}">用当前全文生成课件</button>
  </view>
  <view class="section-head">
    <ui-icon name="folder" size="32" color="#5C7A5A"></ui-icon>
    <text class="name">我上传的教案</text>
  </view>
  <view class="empty" wx:if="{{loading}}">正在读取教案…</view>
  <view class="empty" wx:if="{{!loading && !plans.length}}">
    <view class="empty-icon">
      <ui-icon name="file" size="48" color="#8A8175"></ui-icon>
    </view>
    还没有讲师教案
  </view>
  <view class="card" wx:for="{{plans}}" wx:key="id">
    <view class="title">{{item.displayTitle}}</view>
    <view class="muted" wx:if="{{item.showOriginal}}">原标题 {{item.originalTitle}}</view>
    <view class="row chips">
      <text class="chip">{{item.status}}</text>
      <text class="chip" wx:if="{{item.topic}}">{{item.topic.name}}</text>
      <text class="chip">{{item.stepCount}} 步</text>
    </view>
    <view class="desc" wx:if="{{item.view.summaryText}}">{{item.view.summaryText}}</view>
    <view class="muted" wx:elif="{{!item.hasAnalysis}}">尚未解析。粘贴全文后点「重新解析」。</view>
    <view wx:if="{{item.view.direction}}">
      <text class="chip">{{item.view.direction}}</text>
    </view>
    <view wx:if="{{item.view.tags.length}}">
      <text class="chip" wx:for="{{item.view.tags}}" wx:for-item="tag" wx:key="*this">{{tag}}</text>
    </view>
    <view class="row wrap">
      <button class="btn mini" size="mini" data-id="{{item.id}}" bindtap="onOpen">查看步骤</button>
      <button class="btn btn-ghost mini" size="mini" data-id="{{item.id}}" bindtap="onReparse">重新解析</button>
      <button class="btn btn-ghost mini" size="mini" data-id="{{item.id}}" bindtap="onPlanPpt">生成课件</button>
    </view>
  </view>
</view>
