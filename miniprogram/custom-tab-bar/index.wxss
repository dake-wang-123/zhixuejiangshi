.tabbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  height: 98rpx;
  padding-bottom: env(safe-area-inset-bottom);
  background: #FFFFFF;
  display: flex;
  border-top: 1rpx solid #E5E5E5;
  z-index: 100;
}

.item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #999999;
}

.item.active {
  color: #4B6EF5;
}

.icon-wrap {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 4rpx;
}

.icon {
  width: 40rpx;
  height: 40rpx;
}

.text {
  font-size: 20rpx;
  line-height: 1.6;
}
