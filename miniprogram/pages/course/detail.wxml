<view class="page study-page">
  <view class="error" wx:if="{{error}}">{{error}}</view>

  <view class="empty" wx:if="{{loading}}">
    <view class="empty-icon">
      <ui-icon name="spark" size="48" color="#8A8175"></ui-icon>
    </view>
    {{hint || '正在进入智学伴练…'}}
  </view>

  <block wx:if="{{!loading && course}}">
    <view class="study-head">
      <view class="muted" wx:if="{{course.category_id}}">{{course.category_id.name}} · 智学伴练</view>
      <view class="muted" wx:else>智学伴练</view>
      <view class="title">{{displayTitle}}</view>
      <view class="muted">问答由智学原样给出，按它自己的程序推进。小程序不改写问题、不另编环节。</view>
    </view>

    <scroll-view scroll-y class="thread" scroll-into-view="{{scrollInto}}" scroll-with-animation>
      <view class="empty cat-table-empty" wx:if="{{planning && !thread.length}}">正在把课题原题发给智学…</view>
      <view class="empty cat-table-empty" wx:elif="{{!thread.length && !sending}}">请直接回答智学的问题。</view>
      <view
        id="m-{{item.id}}"
        class="bubble {{item.role === 'user' ? 'me' : (item.role === 'system' ? 'sys' : 'bot')}}"
        wx:for="{{thread}}"
        wx:key="id"
      >{{item.content}}<text class="cursor" wx:if="{{item.streaming}}">▍</text></view>
      <view class="bubble bot thinking-bubble" wx:if="{{thinking}}">
        <view class="dots">
          <view class="dot"></view>
          <view class="dot"></view>
          <view class="dot"></view>
        </view>
        <view class="think-copy">
          <text>{{thinkHint || '智学正在想这一步…'}}</text>
          <text class="muted" wx:if="{{waitSec >= 3}}">已等待 {{waitSec}} 秒，教案长时会分段讲</text>
        </view>
      </view>
      <view class="follow-wrap" wx:if="{{followUps.length}}">
        <view class="muted">智学建议</view>
        <view
          class="follow"
          wx:for="{{followUps}}"
          wx:key="*this"
          data-text="{{item}}"
          bindtap="onFollow"
        >{{item}}</view>
      </view>
    </scroll-view>

    <view class="composer">
      <view class="draft-row">
        <textarea
          class="draft"
          placeholder="{{recording ? '正在听，再点麦克风结束并转成文字' : '输入或点右侧麦克风说话'}}"
          value="{{draft}}"
          bindinput="onDraft"
          auto-height
          maxlength="2000"
          confirm-type="send"
          bindconfirm="onSend"
        ></textarea>
        <button
          class="mic {{recording ? 'on' : ''}}"
          hover-class="mic-hover"
          catchtap="onMicTap"
        >
          <ui-icon name="mic" size="36" color="{{recording ? '#FFFFFF' : '#5C7A5A'}}"></ui-icon>
        </button>
      </view>
      <view class="row composer-actions">
        <button class="btn btn-ghost mini" size="mini" bindtap="onRetry" wx:if="{{error}}" disabled="{{sending}}">再问一次</button>
        <button class="btn mini" size="mini" bindtap="onSend" disabled="{{sending}}">发送</button>
      </view>
    </view>
  </block>
</view>
